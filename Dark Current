import numpy as np
import matplotlib.pyplot as plt

# Define parameters for the single long dark exposure
total_time = 1800.0  # e.g., total exposure length in seconds
measured_adu = 32.02  # final mean ADU count measured in your long dark frame

# Create synthetic intermediate time steps (e.g., every 10 seconds)
time_steps = np.linspace(0, total_time, num=50)
# Scale ADU linearly assuming constant dark current accumulation rate
adu_counts = (time_steps / total_time) * measured_adu

# Plot the resulting exposure count vs exposure time graph
plt.plot(time_steps, adu_counts, label="Simulated Slope")
plt.xlabel("Exposure Time (s)")
plt.ylabel("Accumulated Counts (ADU)")
plt.title("ADU vs Exposure Time from Single Dark")
plt.grid(True)
plt.legend()
plt.show()

m, c = np.polyfit(time_steps, adu_counts, deg=1)
print(f"Calculation of Simulated Slope: {m}")
